# Balena Cloud live sync
BALENA_API_TOKEN=your_balena_api_key_here
BALENA_FLEET_SLUG=ceo2/massiva

# Neon Postgres (povinné na Vercel)
# Vercel Marketplace → Neon → skopíruj DATABASE_URL
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auto-tickety z health alertov pri Balena syncu (1/0)
ALERT_AUTO_TICKETS=1
# Pri zotavení alertu zatvoriť ticket (1/0). Pri 0 len pridá poznámku.
ALERT_AUTO_CLOSE=1

# Vercel Cron ochrana (Project Settings → Environment Variables)
# Vercel ju automaticky posiela ako Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string

# HTTP API pre botov (Servis bot / Hotline bot). Nikdy necommituj skutočné tokeny.
# Pozri docs/API-boti.md
# SERVIS_BOT_API_TOKEN=slv_servis_vygeneruj_dlhy_nahodny_retazec
# HOTLINE_BOT_API_TOKEN=slv_hotline_vygeneruj_dlhy_nahodny_retazec
# Alebo len SHA-256 hash tokenu (64 hex znakov):
# SERVIS_BOT_API_TOKEN_HASH=
# HOTLINE_BOT_API_TOKEN_HASH=
# Okamžité vypnutie bez mazania tokenu (čiarkou oddelené id):
# API_BOT_DISABLED=servis,hotline
# Extra boti ako JSON pole {id,name,tokenHash}:
# API_BOT_TOKENS=

# Odhad km / času trasy výjazdu (voliteľné). Bez týchto premenných
# sa použije verejný Nominatim + OSRM — žiadny Google billing, žiadny kľúč.
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM_USER_AGENT=ServisList/1.0 (tvoj-email@example.com)
