# Balena Cloud live sync
BALENA_API_TOKEN=your_balena_api_key_here
BALENA_FLEET_SLUG=ceo2/massiva

# Neon Postgres (povinné na Vercel)
# Vercel Marketplace → Neon → skopíruj DATABASE_URL
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auto-tickety z health alertov pri Balena syncu (1/0)
ALERT_AUTO_TICKETS=1
# Pri zotavení alertu zatvoriť ticket (1/0). Pri 0 len pridá poznámku.
ALERT_AUTO_CLOSE=1

# Vercel Cron ochrana (Project Settings → Environment Variables)
# Vercel ju automaticky posiela ako Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string
